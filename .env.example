# Local Postgres (see README.md):
#   brew install postgresql@16 && brew services start postgresql@16 && createdb biocomm_copilot
DATABASE_URL="postgresql://localhost:5432/biocomm_copilot?schema=public"

# Agents call Claude directly (lib/agents/) — no separate backend service.
ANTHROPIC_API_KEY=""

# Shared secret gating the MCP endpoint (app/api/[transport]/route.ts) —
# without it, that endpoint 401s every request rather than failing open.
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=""

# Patent Agent's EPO Open Patent Services client-credentials pair. Free
# registration at https://developers.epo.org — without these the Patent
# Agent fails every run (throws before its first tool call).
EPO_OPS_CLIENT_ID=""
EPO_OPS_CLIENT_SECRET=""

# Observability (AGENT_PLAN.md §6.2) — optional, agents run fine without it.
# LANGFUSE_BASEURL, not LANGFUSE_HOST — the SDK reads this exact name and
# silently falls back to its default host if you get it wrong, which looks
# identical to a bad key (401 on every request).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASEURL="https://us.cloud.langfuse.com"
